{
  "name": "links-amarelos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "turbo run dev --filter=@links/website",
    "crayola": "npm run studio -w @links/crayola",
    "playground": "npm run playground -w @links/crayola",
    "build": "turbo run build",
    "lint": "oxlint && turbo run lint",
    "typecheck": "turbo run typecheck",
    "render": "npm run render -w @links/crayola --",
    "render:all": "npm run render:all -w @links/crayola --"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "npm@11.16.0"
}
