{
  "name": "links-amarelos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev -w @links/site",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "oxlint": "^1.79.0"
  }
}
